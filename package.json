{
  "name": "@lucagiftzek/dsh-artifacts",
  "version": "2.1.0",
  "description": "DSH web plugin: artifacts for the web GUI: sidebar tab with versions/diff/pick-and-ask, Markdown-to-page server, two-way chat bridge, local library shelf, media generation, an agent CLI, and a template library with agent tools (artifact_templates, artifact_from_template, artifact_template_save).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "server",
    "contrib",
    "scripts",
    "templates",
    "cordis.patch.yml",
    "skills",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!lib/**/*.map",
    "!lib/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-node.mjs",
    "test": "node test/run.mjs",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "agent-tools",
    "artifacts",
    "deepseek-harness",
    "dsh",
    "dsh-better-sidebar",
    "dsh-plugin",
    "sidebar",
    "templates"
  ],
  "author": {
    "name": "Loukas \"Luca\" Tzekos",
    "url": "https://jobopportunitiesapi.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucagiftzek/dsh-artifacts.git"
  },
  "homepage": "https://github.com/lucagiftzek/dsh-artifacts#readme",
  "bugs": {
    "url": "https://github.com/lucagiftzek/dsh-artifacts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
