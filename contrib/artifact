def cmd_new(args):
    typ = flag(args, "--type", "report")
    title = flag(args, "--title")
    if not args:
        die("usage: artifact new <name> [--type T] [--title ...]")
    name = args[0].strip().strip("/")
    stem = name.rsplit(".", 1)[0] if name.endswith((".md", ".html")) else name
    title = title or stem.replace("-", " ").replace("_", " ").title()
    d = S.REPORT_DIR
    if typ in ("report", "dashboard", "plan", "comparison", "brief", "interactive"):
        p = d / (stem + ".md")
        if p.exists():
            die("%s already exists - edit it instead" % p)
        ex = subprocess.run([str(KIT), "example", typ], capture_output=True, text=True).stdout
        lines = ex.splitlines()
        for i, l in enumerate(lines):
            if l.startswith("title:"):
                lines[i] = "title: " + title
                break
        p.write_text("\n".join(lines) + "\n", encoding="utf-8")
        rel = p.name
    elif typ == "page":
        p = d / (stem + ".html")
        if p.exists():
            die("%s already exists" % p)
        p.write_text(SCAFFOLD_PAGE % {"title": title}, encoding="utf-8")
        rel = p.name
    elif typ == "motion":
        import motion as MO
        try:
            stem = MO.split_name(d, stem)
            proj, page = MO.scaffold(d, stem, title, size=flag(args, "--size"), duration=flag(args, "--duration"))
        except MO.MotionError as e:
            die(str(e))
        for r in (page.name, proj.name, proj.name + "/index.html"):
            claim(r)
        print("created %s (player page)" % page)
        print("edit    %s (the composition)" % (proj / "index.html"))
        print(url(page.name))
        return
    elif typ in ("react", "app"):
        p = d / stem
        if p.exists():
            die("%s already exists" % p)
        p.mkdir(parents=True)
        if typ == "react":
            (p / "index.html").write_text(SCAFFOLD_REACT_HTML % {"title": title}, encoding="utf-8")
            (p / "app.jsx").write_text(SCAFFOLD_REACT_JSX.replace("%(title)s", title), encoding="utf-8")
            main = p / "app.jsx"
        else:
            (p / "index.html").write_text(SCAFFOLD_APP_HTML % {"title": title}, encoding="utf-8")
            (p / "app.js").write_text(SCAFFOLD_APP_JS % {"title": title}, encoding="utf-8")
            main = p / "app.js"
        rel = stem
        claim(rel)
        print("created %s/ (edit %s)" % (p, main))
        print(url(rel))
        return
    else:
        die("unknown --type %s" % typ)
    claim(rel)
    if rel.endswith(".md"):
        claim(view_rel(rel))
    print("created %s" % (d / rel))
    print(url(rel))


def cmd_url(args):
    if not args:
        die("usage: artifact url <name>")
    rel = rel_of(args[0])
    claim(rel)
    print(url(rel))


def cmd_render(args):
    if not args:
        die("usage: artifact render <file.md>")
    r = subprocess.run([str(KIT), "render", args[0]], capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode == 0:
        rel = rel_of(Path(args[0]).expanduser().resolve())
        claim(rel)
        claim(view_rel(rel))
    sys.exit(r.returncode)


def ago(ts):
    s = max(0, int(time.time() - ts))
    return "%ds" % s if s < 60 else "%dm" % (s // 60) if s < 3600 else "%dh" % (s // 3600) if s < 86400 else "%dd" % (s // 86400)


def cmd_list(args):
    n = int(flag(args, "-n", 20))
    allf = flag(args, "--all", False)
    idx = S.build_index(SESSION if SESSION and not allf else None)
    items = idx["items"]
    if SESSION and not allf:
        items = [i for i in items if i.get("mine")]
    for it in items[:n]:
        print("%-6s %-5s %-48s %s" % (it["kind"], ago(it["mtime"]), it["name"][:48], (it.get("title") or "")[:50]))
    if not items:
        print("(none%s)" % (" from this chat - try --all" if SESSION and not allf else ""))


def cmd_show(args):
    rel = rel_of(args[0]) if args else die("usage: artifact show <name>")
    src = S.source_rel(view_rel(rel) if rel.endswith(".md") else rel)
    vs = S.versions_of(src)
    st = S._json_load(S._state_path(view_rel(rel)), {})
    print("url:      %s" % url(rel))
    print("source:   %s" % (S.REPORT_DIR / src))
    print("versions: %d%s" % (len(vs), (" (latest %s ago)" % ago(vs[-1]["mtime"])) if vs else ""))
    print("storage:  %s" % (", ".join(sorted(st)) or "(empty)"))
    print("public:   %s" % ("yes" if os.path.exists(str(S.REPORT_DIR / view_rel(rel)) + ".public") else "no"))


def cmd_versions(args):
    rel = rel_of(args[0]) if args else die("usage: artifact versions <name>")
    src = S.source_rel(view_rel(rel)) if rel.endswith(".md") else S.source_rel(rel)
    vs = S.versions_of(src)
    for i, v in enumerate(vs):
        print("%s  %s  %6d B%s" % (v["id"], time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(v["mtime"])), v["size"], "  (current)" if i == len(vs) - 1 else ""))
    if not vs:
        print("(no snapshots yet - the indexer takes one within seconds of every change)")


def cmd_diff(args):
    import difflib
    rel = rel_of(args[0]) if args else die("usage: artifact diff <name> [A] [B]")
    src = S.source_rel(view_rel(rel)) if rel.endswith(".md") else S.source_rel(rel)
    vs = [v["id"] for v in S.versions_of(src)]
    if len(vs) < 1:
        die("no snapshots")
    b = args[2] if len(args) > 2 else vs[-1]
    a = args[1] if len(args) > 1 else (vs[vs.index(b) - 1] if b in vs and vs.index(b) > 0 else None)
    if not a:
        die("only one version exists")
    A = (S.version_bytes(src, a) or b"").decode("utf-8", "replace").splitlines()
    B = (S.version_bytes(src, b) or b"").decode("utf-8", "replace").splitlines()
    sys.stdout.write("\n".join(difflib.unified_diff(A, B, "v" + a, "v" + b, lineterm="", n=2)) + "\n")


def cmd_restore(args):
    if len(args) < 2:
        die("usage: artifact restore <name> <version-id>")
    rel = rel_of(args[0])
    src = S.source_rel(view_rel(rel)) if rel.endswith(".md") else S.source_rel(rel)
    data = S.version_bytes(src, args[1])
    if data is None:
        die("no such version")
    S._atomic_write(S.REPORT_DIR / src, data)
    claim(src)
    print("restored %s to %s" % (src, args[1]))


def cmd_inbox(args):
    sess = flag(args, "--session", SESSION)
    clear = flag(args, "--clear", False)
    if not sess:
        die("no session (DSH_SESSION_ID unset); pass --session")
    items = S.inbox_read(sess)
    if not items:
        print("(inbox empty)")
    for it in items:
        when = time.strftime("%H:%M", time.localtime(it.get("time", 0)))
        data = it.get("data")
        text = str(it.get("text", ""))
        extra = (" " + json.dumps(data, ensure_ascii=False)[:600]) if data and json.dumps(data, ensure_ascii=False, separators=(",", ":")) != text else ""
        print("[%s] %s from %s: %s%s" % (when, it.get("kind"), it.get("name"), text[:1200], extra))
    if clear:
        try:
            (S.INBOX / (sess + ".jsonl")).unlink()
        except OSError:
            pass


def cmd_state(args):
    if not args:
        die("usage: artifact state <name> [key]")
    rel = view_rel(rel_of(args[0]))
    data = S._json_load(S._state_path(rel), {})
    if len(args) > 1:
        print(json.dumps(data.get(args[1]), indent=2, ensure_ascii=False))
    else:
        print(json.dumps(data, indent=2, ensure_ascii=False)[:20000])


def cmd_state_set(args):
    if len(args) < 3:
        die("usage: artifact state-set <name> <key> <json-value>")
    rel = view_rel(rel_of(args[0]))
    try:
        v = json.loads(args[2])
    except ValueError:
        v = args[2]
    S.storage_op(rel, "set", key=args[1], value=v)
    print("ok")


def cmd_public(args):
    if len(args) < 2 or args[1] not in ("on", "off"):
        die("usage: artifact public <name> on|off")
    rel = rel_of(args[0])
    names = {rel, view_rel(rel), S.source_rel(view_rel(rel))}
    for n in names:
        m = Path(str(S.REPORT_DIR / n) + ".public")
        if args[1] == "on" and (S.REPORT_DIR / n).exists():
            m.touch()
        elif args[1] == "off" and m.exists():
            m.unlink()
    if args[1] == "on":
        print(BASE.replace("/report", "/report-public") + "/" + view_rel(rel))
    else:
        print("private")


def cmd_media(args):
    import media as M
    if not args:
        die("usage: artifact media image|tts|stt|video|voices|capabilities ...")
    kind = args.pop(0)
    provider = flag(args, "--provider")
    name = flag(args, "--name")
    try:
        if kind == "capabilities":
            print(json.dumps(M.capabilities(), indent=2))
            return
        if kind == "voices":
            print(json.dumps(M.voices(), indent=2)[:4000])
            return
        if kind == "image":
            res = M.image(" ".join(args), provider=provider, name=name, size=flag(args, "--size"))
        elif kind == "tts":
            voice = flag(args, "--voice")
            res = M.tts(" ".join(args), voice=voice, name=name)
        elif kind == "stt":
            p = Path(args[0]).expanduser()
            mime = {"mp3": "audio/mpeg", "wav": "audio/wav", "ogg": "audio/ogg", "m4a": "audio/mp4", "webm": "audio/webm"}.get(p.suffix.lstrip(".").lower(), "audio/mpeg")
            print(M.stt(p.read_bytes(), mime=mime, filename=p.name)["text"])
            return
        elif kind == "video":
            print("generating video (%s) - this can take a while..." % (provider or "local"), file=sys.stderr)
            res = M.video(" ".join(args), provider=provider, name=name)
        else:
            die("unknown media kind %s" % kind)
    except M.MediaError as e:
        die(str(e))
    claim(res["name"])
    print("%s  (%s, %d KB, %s)" % (BASE + "/" + res["name"], res["path"], res["bytes"] // 1024, res.get("provider")))
    print("embed: ![](%s)" % res["name"] if kind == "image" else "embed: [%s](%s)" % (kind, res["name"]))


def cmd_motion(args):
    import motion as MO
    if not args:
        die("usage: artifact motion check|snapshot|export|voice <name> ...")
    sub = args.pop(0)
    if not args:
        die("usage: artifact motion %s <name>" % sub)
    try:
        stem = MO.split_name(S.REPORT_DIR, args.pop(0))
        if sub == "check":
            code, out = MO.check(S.REPORT_DIR, stem, args)
            print(out[-6000:])
            sys.exit(code)
        elif sub == "snapshot":
            pngs = MO.snapshot(S.REPORT_DIR, stem, at=flag(args, "--at"), frames=flag(args, "--frames"))
            for p in pngs:
                print(p)
            if not pngs:
                print("(no frames captured)")
        elif sub in ("export", "render"):
            q = flag(args, "--quality", "looks")
            out, host, tail = MO.export(S.REPORT_DIR, stem, quality=q, fps=flag(args, "--fps"),
                                        fmt=flag(args, "--format", "mp4"), host=flag(args, "--host", "auto"),
                                        resolution=flag(args, "--resolution"), log=lambda m: print(m, file=sys.stderr))
            rel = "%s.motion/renders/%s" % (stem, out.name)
            claim(rel)
            info = {"url": "%s.motion/renders/%s" % (stem, out.name), "file": out.name, "quality": q, "host": host,
                    "size_kb": out.stat().st_size // 1024, "stamp": int(out.stat().st_mtime),
                    "when": time.strftime("%Y-%m-%d %H:%M", time.localtime(out.stat().st_mtime)),
                    "duration": MO.probe_duration(out)}
            S.storage_op(stem + ".html", "set", key="render", value=info)
            for line in [l for l in tail.splitlines() if l.strip() and not any(x in l for x in ("[Render:trace]", "[INFO]", "Framey", "browserGpuMode"))][-2:]:
                if line.strip():
                    print("  " + line.strip()[:200], file=sys.stderr)
            print("%s/%s  (%d KB, %ss, rendered on %s)" % (BASE, rel, info["size_kb"], info["duration"], host))
            print("player: %s/%s.html" % (BASE, stem))
        elif sub == "voice":
            import media as M
            voice = flag(args, "--voice")
            vid = flag(args, "--id", "vo1")
            at = flag(args, "--at", "0")
            text = " ".join(args).strip() or die("usage: artifact motion voice <name> \"text\"")
            proj = MO.project_dir(S.REPORT_DIR, stem)
            res = M.tts(text, voice=voice, name="%s-%s" % (stem, vid))
            src = Path(res["path"])
            dst = proj / "assets" / (vid + src.suffix)
            dst.parent.mkdir(exist_ok=True)
            import shutil
            shutil.copyfile(src, dst)
            dur = MO.probe_duration(dst) or 0
            print("saved %s (%.2fs)" % (dst, dur))
            print("paste inside #root (audio needs an id; it is mixed into the export):")
            print('  <audio id="%s" src="assets/%s" data-start="%s" data-duration="%.2f" data-track-index="9"></audio>'
                  % (vid, dst.name, at, dur))
        else:
            die("unknown motion command %s" % sub)
    except MO.MotionError as e:
        die(str(e))


