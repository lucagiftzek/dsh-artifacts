BASE = os.environ.get("ARTIFACT_BASE_URL", "/report").rstrip("/")
SESSION = os.environ.get("DSH_SESSION_ID", "")
KIT = PLUGIN / "contrib" / "artifact-kit"


def die(msg):
    sys.exit("artifact: " + msg)


def flag(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            v = args[i + 1]
            del args[i:i + 2]
            return v
        del args[i]
        return True
    return default


def rel_of(name):
    """Accept a bare name, a path under ~/reports, or a URL."""
    n = str(name)
    for p in (BASE + "/", "/report/", str(S.REPORT_DIR) + "/", "~/reports/"):
        if n.startswith(p):
            n = n[len(p):]
    n = n.split("?")[0].strip("/")
    rel = S.safe_rel(n)
    if not rel:
        die("bad artifact name: %s" % name)
    return rel


def view_rel(rel):
    """The URL-facing name: x.md -> x.html (rendered)."""
    if rel.endswith(".md"):
        return rel[:-3] + ".html"
    return rel


def url(rel):
    full = S.REPORT_DIR / rel
    if full.is_dir():
        return "%s/%s/" % (BASE, rel)
    return "%s/%s" % (BASE, view_rel(rel))


def claim(rel):
    if SESSION:
        S.add_claim(rel, SESSION, "cli")


