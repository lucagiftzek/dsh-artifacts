HERE = Path(os.path.realpath(__file__)).parent
PLUGIN = HERE.parent
sys.path.insert(0, str(PLUGIN / "server"))
sys.path.insert(0, str(HERE))
os.environ.setdefault("ARTIFACT_DIR", str(Path.home() / "reports"))

