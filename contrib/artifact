  dsh.toast(text)                    small notification

Compatibility: window.claude.complete(prompt) and window.storage.get/set/delete/list (Claude
artifact API), window.openai.sendFollowUpMessage({prompt}) / setWidgetState(s).

No JS needed for simple two-way UI:
  <button data-dsh-send="Approve">Approve</button>     <a data-dsh-context="liked B">B</a>
  <form data-dsh-form="submit|context" data-dsh-title="Survey"> ...fields... </form>

Libraries: <script src="/report/_lib/react.js"> etc. -- run 'artifact libs'. Never use a CDN.
Runtime errors are captured and land in 'artifact inbox' and on the sidebar's Fix button.
"""


def main(argv):
    args = argv[1:]
    if not args or args[0] in ("help", "-h", "--help"):
        topic = args[1] if len(args) > 1 else ""
        if topic in ("md", "markdown", "kit"):
            subprocess.run([str(KIT), "help"])
        elif topic in ("bridge", "js", "dsh", "api"):
            print(BRIDGE_HELP)
        else:
            print(__doc__.strip())
        return
    cmd = args.pop(0)
    table = {"new": cmd_new, "url": cmd_url, "render": cmd_render, "list": cmd_list, "ls": cmd_list,
             "show": cmd_show, "info": cmd_show, "versions": cmd_versions, "diff": cmd_diff,
             "restore": cmd_restore, "inbox": cmd_inbox, "state": cmd_state, "state-set": cmd_state_set,
             "public": cmd_public, "media": cmd_media, "libs": cmd_libs, "motion": cmd_motion,
             "export": lambda a: cmd_motion(["export"] + a)}
    if cmd not in table:
        die("unknown command %s (artifact help)" % cmd)
    table[cmd](args)


if __name__ == "__main__":
    main(sys.argv)
