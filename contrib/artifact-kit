def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return
    cmd = argv[1]
    if cmd == "example":
        print(EXAMPLES.get(argv[2] if len(argv) > 2 else "report", EXAMPLES["report"]))
        return
    if cmd == "render" and len(argv) == 3:
        src = Path(argv[2]).expanduser().resolve()
        if src.suffix != ".md" or not src.is_file():
            sys.exit("render needs an existing .md file")
        out = render(src)
        if out.parent == ARTIFACT_DIR:
            print(f"{BASE_URL}/{out.name}")
        else:
            print(f"wrote {out} (not in {ARTIFACT_DIR}, so it is not served; write the .md into ~/reports/)")
        return
    sys.exit("usage: artifact-kit render <file.md> | example [template] | help")


if __name__ == "__main__":
    main(sys.argv)
