def render_text(text, name="artifact.md"):
    """Markdown source -> complete HTML page (str). Raises Refused on secrets."""
    for pat in SECRET_PATTERNS:
        if pat.search(text):
            raise Refused("%s contains a credential-shaped string; report status, never values" % name)
    meta, body_md = split_front_matter(text)
    template = meta.get("template", "report").lower()
    if template not in TEMPLATES:
        template = "report"
    state = {}
    md = build_md(state)
    title = meta.get("title")
    m = re.match(r"^#\s+(.+)\n", body_md)
    if m and not title:
        title = m.group(1).strip()
    if m:
        body_md = body_md[m.end():]
    title = title or Path(name).stem.replace("-", " ").title()
    body_md, notes = extract_footnotes(body_md)
    body, toc = post_process(md.render(body_md))
    body += render_footnotes(notes, md)
    want_toc = meta.get("toc", "").lower()
    show_toc = (want_toc == "true") or (want_toc != "false" and template in ("report", "plan", "comparison") and len(toc) >= 3)
    toc_html = ('<nav class="toc">' + "".join('<a href="#%s">%s</a>' % (i, t) for i, t in toc) + "</nav>") if show_toc else ""
    metas = "".join("<span>%s</span>" % esc(meta[k]) for k in ("date", "author") if meta.get(k))
    status = '<span class="badge">%s</span>' % esc(meta["status"]) if meta.get("status") else ""
    accent = meta.get("accent", "")
    accent_css = ":root{--accent:%s}" % accent if re.match(r"^#[0-9a-fA-F]{3,8}$", accent) else ""
    libs = ""
    if state.get("mermaid"):
        libs += ('<script src="%s/mermaid.min.js"></script><script>mermaid.initialize({startOnLoad:true,securityLevel:"strict",'
                 'theme:matchMedia("(prefers-color-scheme: dark)").matches?"dark":"default"});</script>' % LIB)
    if state.get("math"):
        libs += ('<link rel="stylesheet" href="%s/katex/katex.min.css"><script src="%s/katex/katex.min.js"></script>'
                 '<script>document.querySelectorAll(".math-display").forEach(e=>{try{katex.render(e.textContent,e,{displayMode:true,throwOnError:false})}catch(x){}})</script>' % (LIB, LIB))
    width = auto_width(template, body_md, meta)
    sub = '<p class="sub">%s</p>' % md.renderInline(meta["subtitle"]) if meta.get("subtitle") else ""
    metabar = '<div class="meta">%s%s</div>' % (status, metas) if status or metas else ""
    return """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>%s</title><meta name="generator" content="artifact-kit 2 (%s)">
<style>%s%s</style></head>
<body class="t-%s" style="--w:%dpx"><main>
<header class="top"><div class="brand">artifact \u00b7 %s</div><h1>%s</h1>
%s
%s</header>
%s%s
<footer>Rendered by artifact-kit from %s.</footer>
</main><script>%s</script>%s</body></html>
""" % (esc(re.sub(r"<[^>]+>", "", title)), template, CSS, accent_css, template, width, template, md.renderInline(title), sub, metabar,
       toc_html, body, esc(Path(name).name), JS, libs)


def render(src: Path) -> Path:
    text = src.read_text(encoding="utf-8")
    try:
        page = render_text(text, src.name)
    except Refused as e:
        sys.exit("refused: %s" % e)
    out = src.with_suffix(".html")
    out.write_text(page, encoding="utf-8")
    os.chmod(out, 0o644)
    return out


