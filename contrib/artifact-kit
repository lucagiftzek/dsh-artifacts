JS = """document.querySelectorAll('table.sortable th').forEach((th,i)=>th.addEventListener('click',()=>{const tb=th.closest('table').tBodies[0];if(!tb)return;const d=th.dataset.dir==='▲'?'▼':'▲';th.closest('tr').querySelectorAll('th').forEach(x=>delete x.dataset.dir);th.dataset.dir=d;const n=v=>parseFloat(v.replace(/[^0-9.\\-]/g,''));[...tb.rows].sort((a,b)=>{const x=a.cells[i]?.innerText||'',y=b.cells[i]?.innerText||'';const r=isNaN(n(x))||isNaN(n(y))?x.localeCompare(y):n(x)-n(y);return d==='▲'?r:-r}).forEach(r=>tb.appendChild(r))}));"""


def render(src: Path) -> Path:
    text = src.read_text(encoding="utf-8")
    for pat in SECRET_PATTERNS:
        if pat.search(text):
            sys.exit(f"refused: {src.name} contains a credential-shaped string; report status, never values")
    meta, body_md = split_front_matter(text)
    template = meta.get("template", "report").lower()
    if template not in TEMPLATES:
        sys.exit(f"unknown template '{template}'; use one of: {', '.join(TEMPLATES)}")
    md = build_md()
    title = meta.get("title")
    m = re.match(r"^#\s+(.+)\n", body_md)
    if m and not title:
        title = m.group(1).strip()
    if m:
        body_md = body_md[m.end():]
    title = title or src.stem.replace("-", " ").title()
    body, toc = post_process(md.render(body_md))
    show_toc = template in ("report", "plan", "comparison") and len(toc) >= 3
    toc_html = ('<nav class="toc">' + "".join(f'<a href="#{i}">{t}</a>' for i, t in toc) + "</nav>") if show_toc else ""
    metas = "".join(f"<span>{esc(meta[k])}</span>" for k in ("date",) if meta.get(k))
    status = f'<span class="badge">{esc(meta["status"])}</span>' if meta.get("status") else ""
    page = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{esc(title)}</title><meta name="generator" content="artifact-kit ({template})">
<style>{CSS}</style></head>
<body style="--w:{WIDTH[template]}px"><main>
<header class="top"><div class="brand">tzekos · {template}</div><h1>{md.renderInline(title)}</h1>
{f'<p class="sub">{md.renderInline(meta["subtitle"])}</p>' if meta.get("subtitle") else ""}
{f'<div class="meta">{status}{metas}</div>' if status or metas else ""}</header>
{toc_html}{body}
<footer>Rendered by artifact-kit from {esc(src.name)}.</footer>
</main><script>{JS}</script></body></html>
"""
    out = src.with_suffix(".html")
    out.write_text(page, encoding="utf-8")
    os.chmod(out, 0o644)
    return out


