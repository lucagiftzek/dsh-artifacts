#!/usr/bin/env python3
"""artifact-kit -- Markdown in, finished themed HTML artifact out.

    artifact-kit render ~/reports/<name>.md     # writes ~/reports/<name>.html, prints its URL
    artifact-kit example [report|dashboard|plan|comparison|brief|interactive]
    artifact-kit help

You usually do not need 'render' any more: the artifact server renders
~/reports/<name>.md on the fly, so https://dsh.example.com/report/<name>.html is
always the current page. Write or edit the .md and the open preview refreshes.

WHY: hand-written HTML reports cost a median 17 KB of output tokens (p90 99 KB)
and then sat in context. Markdown is ~35-40% cheaper on a typical report and far
cheaper on pages with charts/tables (the SVG/CSS is generated here), and partial
edits ('edit' tool on the .md) replace whole-file rewrites.

Markdown = CommonMark + tables + strikethrough + task lists (- [x]).
Fenced blocks named below become components; every other fence is code:

    kpi                     Label | Value | note | good|bad         (one tile per line)
    chart bar|hbar|line|pie|donut [title]   CSV: first column labels, other columns numeric series
    figure [hero|wide]      src | caption | credit   (one per line; 2+ lines = image grid)
    quote                   pull quote; a line '||' then the attribution
    lead                    opening paragraph in larger type
    callout info|ok|warn|risk       Markdown body in a tinted box
    timeline                when | what | detail
    progress                Label | value | max (default 100) | note
    columns [2|3|4]         Markdown columns separated by a line containing only '||' (N = fixed count)
    details <summary text>  collapsible Markdown section
    mermaid                 diagram (flowchart, sequence, gantt, ...), rendered locally
    math                    TeX display math (KaTeX, rendered locally)
    actions                 Label | message sent to the chat | context  (buttons; two-way)
    form <title>            Label | type | options  -> sends the answers to the chat
                            types: text, textarea, number, email, date, select a/b/c,
                            radio a/b/c, check a/b/c, range 0-10; 'form <title> context'
                            stores answers silently for the agent instead of sending.

Media: ![caption](media/x.png) images; links/images ending in .mp3/.wav/.ogg/.m4a
become audio players and .mp4/.webm/.mov video players.

Front matter (optional, between --- lines): title, subtitle, template, status, date,
width (narrow|normal|wide|full), toc (true|false), accent (#hex).
template: report (default) | dashboard | plan | comparison | brief | article.
Footnotes: [^id] in the text and a line "[^id]: note"; listed under Notes at the end.

Output: one file; components needing a library (mermaid, math) load it from
/report/_lib on the same server -- never a CDN.
"""
import html
import math
import os
import re
import sys
from pathlib import Path

from markdown_it import MarkdownIt

BASE_URL = os.environ.get("ARTIFACT_BASE_URL", "/report")
ARTIFACT_DIR = Path(os.environ.get("ARTIFACT_DIR", str(Path.home() / "reports"))).resolve()
LIB = "/report/_lib"
TEMPLATES = ("report", "dashboard", "plan", "comparison", "brief", "article")
WIDTH = {"report": 900, "plan": 900, "brief": 760, "dashboard": 1240, "comparison": 1200, "article": 780}
WIDTH_WORDS = {"narrow": 720, "normal": 900, "wide": 1200, "full": 100000}
SECRET_PATTERNS = [
    re.compile(r"sk-ant-(oat|api)|-----BEGIN [A-Z ]*PRIVATE KEY-----|(sk|ghp|gho|xox[baprs])-[A-Za-z0-9]{16,}"),
    re.compile(r"(^|\s)([A-Z0-9_]*(API_KEY|SECRET|TOKEN|PASSWORD|PASSWD)[A-Z0-9_]*)\s*=\s*\S{8,}"),
]
SERIES = ["var(--accent)", "#4f8fbf", "#7a9a4a", "#b38b2d", "#8a6bb8", "#5f9e96", "#c0607a", "#6f7f8f"]
AUDIO_EXT = (".mp3", ".wav", ".ogg", ".oga", ".m4a", ".aac", ".flac", ".opus")
VIDEO_EXT = (".mp4", ".webm", ".mov", ".m4v")
FENCE_RX = re.compile(r"(?ms)^\x60\x60\x60[^\n]*\n(.*?)^\x60\x60\x60")
CODE_FENCE_RX = re.compile(r"(?ms)^\x60\x60\x60([^\n]*)\n(.*?)^\x60\x60\x60")
COMPONENTS = {"kpi", "chart", "callout", "timeline", "progress", "columns", "details", "actions", "form",
              "figure", "quote", "lead", "math", "latex", "tex"}

esc = html.escape


class Refused(ValueError):
    pass


def split_front_matter(text):
    meta = {}
    if text.startswith("---\n"):
        end = text.find("\n---", 4)
        if end != -1:
            for line in text[4:end].splitlines():
                if ":" in line:
                    k, v = line.split(":", 1)
                    meta[k.strip().lower()] = v.strip().strip("'\"")
            text = text[end + 4:].lstrip("\n")
    return meta, text


def cells(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def text_w(s, px=12):
    """Rough rendered width of a label in px (SVG text cannot be measured server-side)."""
    wide = sum(1 for ch in s if ch.isupper() or ch in "MWmw@%")
    # 0.64 em/char is measured on common fonts (system-ui renders wider than
    # the classic 0.5-0.55 rule of thumb); overestimating only costs margin.
    return (len(s) * 0.64 + wide * 0.16) * px


def clip(s, n):
    return s if len(s) <= n else s[: n - 1] + "\u2026"


# -- components ------------------------------------------------------------------

def render_kpi(body, md):
    tiles = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", "", ""]
        label, value, note, verdict = c[0], c[1], c[2], c[3].lower()
        tone = ""
        if verdict in ("good", "bad"):
            tone = " up" if verdict == "good" else " down"
        elif re.match(r"^[+\u25b2\u2191]", note):
            tone = " up"
        elif re.match(r"^[-\u2212\u25bc\u2193]", note):
            tone = " down"
        long = " long" if len(value) > 10 else ""
        tiles.append('<div class="kpi"><div class="kpi-label">%s</div><div class="kpi-value%s">%s</div>%s</div>' % (
            md.renderInline(label), long, md.renderInline(value),
            '<div class="kpi-note%s">%s</div>' % (tone, md.renderInline(note)) if note else ""))
    return '<div class="kpis">%s</div>' % "".join(tiles)


def number(s):
    s = s.replace(",", "").replace("%", "").replace("\u20ac", "").replace("$", "").replace("\u00a3", "").strip()
    try:
        return float(s)
    except ValueError:
        return None


def nice_max(v):
    if v <= 0:
        return 1
    exp = 10 ** math.floor(math.log10(v))
    for m in (1, 2, 2.5, 5, 10):
        if v <= m * exp:
            return m * exp
    return 10 * exp


def fmt(v):
    if abs(v) >= 1e9:
        return ("%.1fB" % (v / 1e9)).replace(".0B", "B")
    if abs(v) >= 1e6:
        return ("%.1fM" % (v / 1e6)).replace(".0M", "M")
    if abs(v) >= 1e3:
        return ("%.1fk" % (v / 1e3)).replace(".0k", "k")
    return "%g" % round(v, 2)


def parse_rows(body):
    """Rows of a chart block: pipe- or comma-separated, quotes respected.

    A row with MORE cells than the header almost always means the label itself
    contained a comma ("Paris, FR,12"), so the surplus is folded back into the
    label instead of shifting every value one column to the right.
    """
    import csv
    raw = [l for l in body.strip().splitlines() if l.strip()]
    rows = []
    for l in raw:
        if "|" in l:
            rows.append(cells(l))
        else:
            rows.append([c.strip() for c in next(csv.reader([l], skipinitialspace=True))])
    if rows:
        width = len(rows[0])
        fixed = [rows[0]]
        for r in rows[1:]:
            if len(r) > width > 1:
                cut = len(r) - (width - 1)
                r = [", ".join(r[:cut])] + r[cut:]
            fixed.append(r)
        rows = fixed
    return rows


def render_chart(kind, body):
    rows = parse_rows(body)
    if len(rows) < 2:
        return '<p class="err">chart: need a header row and at least one data row</p>'
    header, data = rows[0], rows[1:]
    labels = [r[0] for r in data]
    series = []
    for j, name in enumerate(header[1:], start=1):
        vals = [number(r[j]) if j < len(r) else None for r in data]
        series.append((name, [v if v is not None else 0 for v in vals]))
    if not series:
        return '<p class="err">chart: need at least one numeric column</p>'
    multi = len(series) > 1
    legend = "".join('<span><i style="background:%s"></i>%s</span>' % (SERIES[i % len(SERIES)], esc(n))
                     for i, (n, _) in enumerate(series)) if multi else ""

    if kind in ("pie", "donut"):
        vals = series[0][1]
        total = sum(v for v in vals if v > 0) or 1
        r, cx, cy = 90, 110, 110
        out, a0 = [], -math.pi / 2
        for i, v in enumerate(vals):
            if v <= 0:
                continue
            a1 = a0 + 2 * math.pi * v / total
            large = 1 if a1 - a0 > math.pi else 0
            x0, y0 = cx + r * math.cos(a0), cy + r * math.sin(a0)
            x1, y1 = cx + r * math.cos(a1), cy + r * math.sin(a1)
            col = SERIES[i % len(SERIES)]
            tip = '<title>%s: %s (%.0f%%)</title>' % (esc(labels[i]), fmt(v), 100 * v / total)
            if v >= total:
                out.append('<circle cx="%d" cy="%d" r="%d" fill="%s">%s</circle>' % (cx, cy, r, col, tip))
            else:
                out.append('<path d="M%d,%d L%.1f,%.1f A%d,%d 0 %d 1 %.1f,%.1f Z" fill="%s">%s</path>'
                           % (cx, cy, x0, y0, r, r, large, x1, y1, col, tip))
            a0 = a1
        hole = '<circle cx="%d" cy="%d" r="52" fill="var(--panel)"/>' % (cx, cy) if kind == "donut" else ""
        leg = "".join('<span><i style="background:%s"></i>%s <b>%.0f%%</b></span>' % (SERIES[i % len(SERIES)], esc(l), 100 * max(v, 0) / total)
                      for i, (l, v) in enumerate(zip(labels, vals)))
        return ('<figure class="chart pie"><svg viewBox="0 0 220 220" role="img">%s%s</svg><figcaption>%s</figcaption></figure>'
                % ("".join(out), hole, leg))

    peak = max(max(v for v in s[1]) for s in series) or 1
    tick = nice_max(peak / 5)
    ticks = max(1, math.ceil(peak / tick - 1e-9))
    top = tick * ticks
    if kind == "hbar":
        fs = 13
        lab_px = min(320, max(60, max(text_w(l, fs) for l in labels) + 14))
        maxc = int((lab_px - 14) / (fs * 0.6)) + 2
        rowh = 24 if multi else 28
        w = max(640, int(lab_px + 420))
        val_px = max(text_w(fmt(v), fs) for s in series for v in s[1]) + 12
        h = rowh * len(labels) * len(series) + 8 * len(labels) + 10
        out, y = [], 5
        for li, lab in enumerate(labels):
            out.append('<text x="%.0f" y="%.1f" text-anchor="end" class="t"><title>%s</title>%s</text>'
                       % (lab_px - 8, y + rowh * len(series) / 2 + 4, esc(lab), esc(clip(lab, maxc))))
            for si, (n, vals) in enumerate(series):
                bw = (w - lab_px - val_px - 8) * max(vals[li], 0) / top
                out.append('<rect x="%.0f" y="%d" width="%.1f" height="%d" rx="2" fill="%s"><title>%s \u00b7 %s: %s</title></rect>'
                           '<text x="%.1f" y="%.1f" class="t">%s</text>'
                           % (lab_px, y + 3, bw, rowh - 7, SERIES[si % len(SERIES)], esc(lab), esc(n), fmt(vals[li]),
                              lab_px + bw + 6, y + rowh / 2 + 4, fmt(vals[li])))
                y += rowh
            y += 8
        svg = '<svg viewBox="0 0 %d %d" role="img">%s</svg>' % (w, h, "".join(out))
    else:
        fs = 12
        n = len(labels)
        w = max(720, min(1600, n * 46))
        longest = max(text_w(l, fs) for l in labels)
        step_guess = (w - 60) / max(n, 1)
        rotate = longest > step_guess * 0.92
        b = 30 if not rotate else int(min(160, longest * 0.63 + 20))
        maxc = 28 if rotate else max(4, int(step_guess / (fs * 0.6)))
        l_axis = int(max(text_w(fmt(top), fs), 24) + 14)
        if rotate:
            # A rotated first label hangs left of its tick: make room for it.
            first = min(text_w(clip(labels[0], maxc), fs), 230) * 0.79
            l_axis = int(max(l_axis, min(first - step_guess / 2 + 16, 220)))
        t, h = 12, 270 + (b - 30)
        pw, ph = w - l_axis - 12, h - b - t
        grid = []
        for k in range(ticks + 1):
            gy = t + ph - ph * k / ticks
            grid.append('<line x1="%d" x2="%d" y1="%.1f" y2="%.1f" class="g"/><text x="%d" y="%.1f" text-anchor="end" class="t">%s</text>'
                        % (l_axis, w - 12, gy, gy, l_axis - 6, gy + 4, fmt(tick * k)))
        step = pw / n
        every = max(1, math.ceil(n / (24 if rotate else 14)))
        xl = []
        for i, lab in enumerate(labels):
            if i % every:
                continue
            x = l_axis + step * i + step / 2
            if rotate:
                xl.append('<text x="%.1f" y="%d" text-anchor="end" transform="rotate(-38 %.1f %d)" class="t"><title>%s</title>%s</text>'
                          % (x, h - b + 14, x, h - b + 14, esc(lab), esc(clip(lab, maxc))))
            else:
                xl.append('<text x="%.1f" y="%d" text-anchor="middle" class="t"><title>%s</title>%s</text>'
                          % (x, h - b + 18, esc(lab), esc(clip(lab, maxc))))
        marks = []
        if kind == "line":
            for si, (name, vals) in enumerate(series):
                col = SERIES[si % len(SERIES)]
                pts = " ".join("%.1f,%.1f" % (l_axis + step * i + step / 2, t + ph - ph * v / top) for i, v in enumerate(vals))
                marks.append('<polyline points="%s" fill="none" stroke="%s" stroke-width="2.5" stroke-linejoin="round"/>' % (pts, col))
                if n <= 60:
                    marks += ['<circle cx="%.1f" cy="%.1f" r="3.5" fill="%s"><title>%s \u00b7 %s: %s</title></circle>'
                              % (l_axis + step * i + step / 2, t + ph - ph * v / top, col, esc(labels[i]), esc(name), fmt(v))
                              for i, v in enumerate(vals)]
        else:
            gw = min(step * 0.72, 56 * len(series))
            bw = gw / len(series)
            for i in range(n):
                for si, (name, vals) in enumerate(series):
                    bh = ph * max(vals[i], 0) / top
                    x = l_axis + step * i + (step - gw) / 2 + si * bw
                    marks.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" rx="1.5" fill="%s"><title>%s \u00b7 %s: %s</title></rect>'
                                 % (x, t + ph - bh, max(bw - 1, 0.5), bh, SERIES[si % len(SERIES)], esc(labels[i]), esc(name), fmt(vals[i])))
        svg = '<svg viewBox="0 0 %d %d" role="img">%s%s%s</svg>' % (w, h, "".join(grid), "".join(marks), "".join(xl))
    return '<figure class="chart">%s%s</figure>' % (svg, '<figcaption>%s</figcaption>' % legend if legend else "")


def render_timeline(body, md):
    items = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", ""]
        items.append('<li><span class="when">%s</span><div><b>%s</b>%s</div></li>' % (
            md.renderInline(c[0]), md.renderInline(c[1]), '<p>%s</p>' % md.renderInline(c[2]) if c[2] else ""))
    return '<ol class="timeline">%s</ol>' % "".join(items)


def render_progress(body, md):
    rows = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", "", ""]
        v = number(c[1]) or 0
        mx = number(c[2]) or 100
        pct = max(0, min(100, 100 * v / mx if mx else 0))
        shown = esc(c[1]) + ((" / " + esc(c[2])) if c[2] else ("" if "%" in c[1] else "%"))
        rows.append('<div class="prog"><div class="prog-h"><span>%s</span><span class="prog-v">%s</span></div>'
                    '<div class="bar"><i style="width:%.1f%%"></i></div>%s</div>' % (
                        md.renderInline(c[0]), shown, pct,
                        '<div class="prog-n">%s</div>' % md.renderInline(c[3]) if c[3] else ""))
    return '<div class="progs">%s</div>' % "".join(rows)


def render_actions(body, md):
    btns = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", ""]
        label, msg, mode = c[0], c[1] or c[0], c[2].lower()
        attr = "data-dsh-context" if mode == "context" else "data-dsh-send"
        btns.append('<button type="button" class="act" %s="%s">%s</button>' % (attr, esc(msg, quote=True), md.renderInline(label)))
    return '<div class="actions">%s</div>' % "".join(btns)


def render_form(arg_rest, body, md):
    words = arg_rest.split()
    mode = "context" if words and words[-1].lower() == "context" else "submit"
    if mode == "context":
        words = words[:-1]
    title = " ".join(words) or "Form"
    fields = []
    for i, line in enumerate(body.strip().splitlines()):
        if not line.strip():
            continue
        c = cells(line) + ["", ""]
        label, spec = c[0], (c[1] or "text").strip()
        kind, _, opts = spec.partition(" ")
        kind = kind.lower()
        opts = opts or c[2]
        name = re.sub(r"[^a-z0-9]+", "_", label.lower()).strip("_") or "f%d" % i
        L = md.renderInline(label)
        if kind == "textarea":
            ctl = '<textarea name="%s" rows="3"></textarea>' % name
        elif kind == "select":
            ctl = '<select name="%s">%s</select>' % (name, "".join('<option>%s</option>' % esc(o.strip()) for o in opts.split("/") if o.strip()))
        elif kind in ("radio", "check", "checkbox"):
            t = "radio" if kind == "radio" else "checkbox"
            ctl = '<span class="opts">%s</span>' % "".join(
                '<label class="opt"><input type="%s" name="%s" value="%s"> %s</label>' % (t, name, esc(o.strip(), quote=True), esc(o.strip()))
                for o in opts.split("/") if o.strip())
            fields.append('<fieldset class="field"><legend>%s</legend>%s</fieldset>' % (L, ctl))
            continue
        elif kind == "range":
            lo, _, hi = (opts or "0-10").partition("-")
            ctl = ('<input type="range" name="%s" min="%s" max="%s" oninput="this.nextElementSibling.textContent=this.value"><output></output>'
                   % (name, esc(lo or "0"), esc(hi or "10")))
        elif kind in ("number", "email", "date", "time", "url", "text", "color"):
            ctl = '<input type="%s" name="%s">' % (kind, name)
        else:
            ctl = '<input type="text" name="%s">' % name
        fields.append('<label class="field"><span>%s</span>%s</label>' % (L, ctl))
    btn = "Save for the agent" if mode == "context" else "Send to chat"
    return ('<form class="dsh-form" data-dsh-form="%s" data-dsh-title="%s"><div class="form-t">%s</div>%s'
            '<div class="form-b"><button type="submit" class="act primary">%s</button></div></form>'
            % (mode, esc(title, quote=True), esc(title), "".join(fields), btn))


def build_md(state):
    md = MarkdownIt("commonmark", {"html": True, "linkify": False, "typographer": True}).enable(["table", "strikethrough"])
    default_fence = md.renderer.rules.get("fence")

    def fence(tokens, idx, options, env):
        tok = tokens[idx]
        info = tok.info.strip()
        parts = info.split(None, 1)
        name = parts[0].lower() if parts else ""
        rest = parts[1] if len(parts) > 1 else ""
        arg = rest.split()[0].lower() if rest else ""
        if name == "kpi":
            return render_kpi(tok.content, md)
        if name == "chart":
            out = render_chart(arg or "bar", tok.content)
            title = rest.split(None, 1)[1].strip() if len(rest.split(None, 1)) > 1 else ""
            if title and out.startswith("<figure"):
                head = out.index(">") + 1
                out = (out[:head] + '<div class="chart-t">%s</div>' % md.renderInline(title)
                       + out[head:].replace('role="img"', 'role="img" aria-label="%s"' % esc(title), 1))
            return out
        if name == "figure":
            return render_figures(arg, tok.content, md)
        if name == "quote":
            parts = re.split(r"(?m)^\s*\|\|\s*$", tok.content, maxsplit=1)
            by = '<figcaption>%s</figcaption>' % md.renderInline(parts[1].strip()) if len(parts) > 1 and parts[1].strip() else ""
            return '<figure class="pullquote"><blockquote>%s</blockquote>%s</figure>' % (md.render(parts[0]), by)
        if name == "lead":
            return '<div class="lead">%s</div>' % md.render(tok.content)
        if name == "timeline":
            return render_timeline(tok.content, md)
        if name == "progress":
            return render_progress(tok.content, md)
        if name == "callout":
            tone = arg if arg in ("info", "ok", "warn", "risk") else "info"
            return '<aside class="callout %s">%s</aside>' % (tone, md.render(tok.content))
        if name == "columns":
            cols = re.split(r"(?m)^\s*\|\|\s*$", tok.content)
            fixed = " cols-%s" % arg if arg in ("2", "3", "4") else ""
            return '<div class="cols%s">%s</div>' % (fixed, "".join('<div class="col">%s</div>' % md.render(c) for c in cols))
        if name == "details":
            return '<details><summary>%s</summary>%s</details>' % (md.renderInline(rest or "Details"), md.render(tok.content))
        if name == "mermaid":
            state["mermaid"] = True
            return '<pre class="mermaid">%s</pre>' % esc(tok.content)
        if name in ("math", "latex", "tex"):
            state["math"] = True
            return '<div class="math-display">%s</div>' % esc(tok.content.strip())
        if name == "actions":
            return render_actions(tok.content, md)
        if name == "form":
            return render_form(rest, tok.content, md)
        return default_fence(tokens, idx, options, env)

    md.renderer.rules["fence"] = fence
    return md


def render_figures(arg, body, md):
    """figure [hero|wide]: one 'src | caption | credit' per line; two or more lines become a grid."""
    figs = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", ""]
        src, cap, credit = c[0], c[1], c[2]
        if not src:
            continue
        alt = re.sub(r"[*_`\[\]]", "", cap) or Path(src.split("?")[0]).stem.replace("-", " ")
        tail = ""
        if cap or credit:
            tail = "<figcaption>%s%s</figcaption>" % (md.renderInline(cap),
                                                       ' <span class="credit">%s</span>' % md.renderInline(credit) if credit else "")
        figs.append('<figure class="fig%s"><img src="%s" alt="%s" loading="lazy" decoding="async">%s</figure>'
                    % (" hero" if arg == "hero" else " wide" if arg == "wide" else "", esc(src, quote=True), esc(alt, quote=True), tail))
    if len(figs) > 1:
        return '<div class="figs">%s</div>' % "".join(figs)
    return "".join(figs)


FOOTNOTE_DEF = re.compile(r"(?m)^\[\^([^\]\s]+)\]:[ \t]*(.*(?:\n(?:[ \t]{2,}|\t).*)*)\n?")


def extract_footnotes(body_md):
    """Markdown footnotes: [^id] in the text, '[^id]: note' on its own line. Fenced code is left alone."""
    chunks = re.split(r"(?ms)(^\x60\x60\x60.*?^\x60\x60\x60[^\n]*$)", body_md)
    defs = {}
    for i in range(0, len(chunks), 2):
        def keep(m):
            defs[m.group(1)] = re.sub(r"\n[ \t]+", " ", m.group(2)).strip()
            return ""
        chunks[i] = FOOTNOTE_DEF.sub(keep, chunks[i])
    if not defs:
        return body_md, []
    order = []

    def ref(m):
        k = m.group(1)
        if k not in defs:
            return m.group(0)
        if k not in order:
            order.append(k)
        n = order.index(k) + 1
        return '<sup class="fnref"><a href="#fn-%s" id="fnref-%s" aria-label="Footnote %d">%d</a></sup>' % (slug(k), slug(k), n, n)
    for i in range(0, len(chunks), 2):
        chunks[i] = re.sub(r"\[\^([^\]\s]+)\](?!:)", ref, chunks[i])
    order += [k for k in defs if k not in order]
    return "".join(chunks), [(k, defs[k]) for k in order]


def render_footnotes(notes, md):
    if not notes:
        return ""
    items = "".join('<li id="fn-%s">%s <a href="#fnref-%s" class="fnback" aria-label="Back to the text">\u21a9</a></li>'
                    % (slug(k), md.renderInline(t), slug(k)) for k, t in notes)
    return '<section class="footnotes" aria-label="Footnotes"><h2 id="notes">Notes</h2><ol>%s</ol></section>' % items


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:60] or "s"


def media_tag(src, alt):
    low = src.lower().split("?")[0]
    cap = "<figcaption>%s</figcaption>" % alt if alt else ""
    if low.endswith(AUDIO_EXT):
        return '<figure class="media"><audio controls preload="metadata" src="%s"></audio>%s</figure>' % (src, cap)
    if low.endswith(VIDEO_EXT):
        return '<figure class="media"><video controls preload="metadata" playsinline src="%s"></video>%s</figure>' % (src, cap)
    return None


def post_process(body):
    body = re.sub(r"<li>\[ \]\s*", '<li class="task"><span class="box"></span>', body)
    body = re.sub(r"<li>\[[xX]\]\s*", '<li class="task done"><span class="box">\u2713</span>', body)
    body = re.sub(r'<img src="([^"]+)" alt="([^"]*)"\s*/?>', lambda m: media_tag(m.group(1), m.group(2)) or m.group(0), body)
    body = re.sub(r'<a href="([^"]+)">([^<]*)</a>', lambda m: media_tag(m.group(1), m.group(2)) or m.group(0), body)
    toc = []

    def anchor(m):
        level, inner = m.group(1), m.group(2)
        text = re.sub(r"<[^>]+>", "", inner)
        sid = slug(html.unescape(text))
        if level == "2":
            toc.append((sid, text))
        return '<h%s id="%s">%s</h%s>' % (level, sid, inner, level)
    body = re.sub(r"<h([23])>(.*?)</h\1>", anchor, body)
    body = body.replace("<table>", '<div class="tw"><table class="sortable">').replace("</table>", "</table></div>")
    return body, toc


def auto_width(template, body_md, meta):
    w = meta.get("width", "").lower()
    if w in WIDTH_WORDS:
        return WIDTH_WORDS[w]
    if w.isdigit():
        return max(480, int(w))
    base = WIDTH[template]
    # Wide tables or long code lines need room; a short brief does not.
    cols = max((l.count("|") - 1 for l in body_md.splitlines() if l.strip().startswith("|")), default=0)
    # Only real code blocks: component fences (figure, quote, kpi...) wrap their own text.
    code = [m.group(2) for m in CODE_FENCE_RX.finditer(body_md) if (m.group(1).split() or [""])[0].lower() not in COMPONENTS]
    longest_code = max((len(x) for blk in code for x in blk.splitlines()), default=0)
    if cols >= 7 or longest_code > 110:
        base = max(base, 1200)
    elif cols >= 5:
        base = max(base, 1040)
    return base


