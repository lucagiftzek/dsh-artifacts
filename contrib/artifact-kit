#!/usr/bin/env python3
"""artifact-kit — render a short Markdown file into a finished, themed HTML artifact.

    artifact-kit render ~/reports/<name>.md     # writes ~/reports/<name>.html, prints its URL
    artifact-kit example [report|dashboard|plan|comparison|brief]
    artifact-kit help

WHY (2026-09-27): agents hand-wrote every report as full HTML: a median of 17 KB (p90
99 KB) of output tokens, which then sat in context for the rest of the chat. Measured on
72 recent reports, the HTML is a median 1.6x its visible text, so writing Markdown saves
roughly 35-40% of output on a typical report, and far more on pages heavy with charts,
tables or styling (the SVG/CSS is generated here, not written). It also removes the
restyle-and-rewrite loops. This is the cheap default for
reports, dashboards, plans, comparisons and briefs. Anything bespoke (an interactive
tool, a mini app, a custom visual) is still hand-written HTML; the kit does not limit
that.

Markdown is CommonMark + tables + task lists (`- [x]`). Fenced blocks named below
become components; every other fence is a code block:

    ```kpi                      one tile per line:  Label | Value | note | good|bad (last two optional;
                                colour follows the note's +/- sign unless good/bad says otherwise)
    ```chart bar|hbar|line      CSV: first column = labels, other columns = numeric series
    ```callout info|ok|warn|risk  Markdown body in a tinted box
    ```timeline                 one row per line:  when | what | detail (optional)

Front matter (optional, between --- lines): title, subtitle, template, status, date.
template: report (default) | dashboard | plan | comparison | brief.

Stdlib + markdown-it-py only. Output is one self-contained file: no CDN, no external
script, light and dark themes.
"""
import html
import math
import os
import re
import sys
from pathlib import Path

from markdown_it import MarkdownIt

BASE_URL = os.environ.get("ARTIFACT_BASE_URL", "https://llm.tzekos.eu/report")
ARTIFACT_DIR = Path(os.environ.get("ARTIFACT_DIR", str(Path.home() / "reports"))).resolve()
TEMPLATES = ("report", "dashboard", "plan", "comparison", "brief")
WIDTH = {"report": 880, "plan": 880, "brief": 760, "dashboard": 1240, "comparison": 1240}
# Same refusals as contrib/publish-artifact: nothing credential-shaped leaves the box.
SECRET_PATTERNS = [
    re.compile(r"sk-ant-(oat|api)|-----BEGIN [A-Z ]*PRIVATE KEY-----|(sk|ghp|gho|xox[baprs])-[A-Za-z0-9]{16,}"),
    re.compile(r"(^|\s)([A-Z0-9_]*(API_KEY|SECRET|TOKEN|PASSWORD|PASSWD)[A-Z0-9_]*)\s*=\s*\S{8,}"),
]
SERIES = ["var(--accent)", "#4f8fbf", "#7a9a4a", "#b38b2d", "#8a6bb8", "#5f9e96"]

esc = html.escape


# ── front matter ──────────────────────────────────────────────────────────────
def split_front_matter(text):
    meta = {}
    if text.startswith("---\n"):
        end = text.find("\n---", 4)
        if end != -1:
            for line in text[4:end].splitlines():
                if ":" in line:
                    k, v = line.split(":", 1)
                    meta[k.strip().lower()] = v.strip().strip("'\"")
            text = text[end + 4:].lstrip("\n")
    return meta, text


# ── components ────────────────────────────────────────────────────────────────
def cells(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def render_kpi(body, md):
    tiles = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", "", ""]
        label, value, note, verdict = c[0], c[1], c[2], c[3].lower()
        tone = ""
        if verdict in ("good", "bad"):
            tone = " up" if verdict == "good" else " down"
        elif re.match(r"^[+▲↑]", note):
            tone = " up"
        elif re.match(r"^[-−▼↓]", note):
            tone = " down"
        tiles.append(f'<div class="kpi"><div class="kpi-label">{md.renderInline(label)}</div>'
                     f'<div class="kpi-value">{md.renderInline(value)}</div>'
                     + (f'<div class="kpi-note{tone}">{md.renderInline(note)}</div>' if note else "")
                     + "</div>")
    return f'<div class="kpis">{"".join(tiles)}</div>'


def number(s):
    s = s.replace(",", "").replace("%", "").replace("€", "").replace("$", "").strip()
    try:
        return float(s)
    except ValueError:
        return None


def nice_max(v):
    if v <= 0:
        return 1
    exp = 10 ** math.floor(math.log10(v))
    for m in (1, 2, 2.5, 5, 10):
        if v <= m * exp:
            return m * exp
    return 10 * exp


def fmt(v):
    if abs(v) >= 1e6:
        return f"{v/1e6:.1f}M".replace(".0M", "M")
    if abs(v) >= 1e3:
        return f"{v/1e3:.1f}k".replace(".0k", "k")
    return f"{v:g}"


def render_chart(kind, body):
    rows = [cells(l.replace(",", "|")) if "|" not in l else cells(l) for l in body.strip().splitlines() if l.strip()]
    if len(rows) < 2:
        return '<p class="err">chart: need a header row and at least one data row</p>'
    header, data = rows[0], rows[1:]
    labels = [r[0] for r in data]
    series = []
    for j, name in enumerate(header[1:], start=1):
        vals = [number(r[j]) if j < len(r) else None for r in data]
        series.append((name, [v if v is not None else 0 for v in vals]))
    if not series:
        return '<p class="err">chart: need at least one numeric column</p>'
    top = nice_max(max(max(v for v in s[1]) for s in series) or 1)
    legend = "".join(f'<span><i style="background:{SERIES[i % len(SERIES)]}"></i>{esc(n)}</span>'
                     for i, (n, _) in enumerate(series)) if len(series) > 1 else ""
    if kind == "hbar":
        rowh, lw, w = 26, 150, 640
        h = rowh * len(labels) * max(1, len(series)) + 10
        out = []
        y = 5
        for li, lab in enumerate(labels):
            out.append(f'<text x="{lw-8}" y="{y + rowh*len(series)/2 + 4}" text-anchor="end" class="t">{esc(lab[:24])}</text>')
            for si, (n, vals) in enumerate(series):
                bw = (w - lw - 60) * vals[li] / top
                out.append(f'<rect x="{lw}" y="{y+3}" width="{bw:.1f}" height="{rowh-8}" fill="{SERIES[si % len(SERIES)]}">'
                           f'<title>{esc(lab)} · {esc(n)}: {fmt(vals[li])}</title></rect>'
                           f'<text x="{lw+bw+6:.1f}" y="{y+rowh/2+3}" class="t">{fmt(vals[li])}</text>')
                y += rowh
        svg = f'<svg viewBox="0 0 {w} {h}" role="img">{"".join(out)}</svg>'
    else:
        w, h, l, b, t = 720, 260, 48, 40, 12
        pw, ph = w - l - 12, h - b - t
        grid = []
        for k in range(5):
            gy = t + ph - ph * k / 4
            grid.append(f'<line x1="{l}" x2="{w-12}" y1="{gy:.1f}" y2="{gy:.1f}" class="g"/>'
                        f'<text x="{l-6}" y="{gy+4:.1f}" text-anchor="end" class="t">{fmt(top*k/4)}</text>')
        n = len(labels)
        step = pw / n
        every = max(1, math.ceil(n / 12))
        xl = "".join(f'<text x="{l + step*i + step/2:.1f}" y="{h-b+18}" text-anchor="middle" class="t">{esc(lab[:12])}</text>'
                     for i, lab in enumerate(labels) if i % every == 0)
        marks = []
        if kind == "line":
            for si, (name, vals) in enumerate(series):
                pts = " ".join(f"{l + step*i + step/2:.1f},{t + ph - ph*v/top:.1f}" for i, v in enumerate(vals))
                col = SERIES[si % len(SERIES)]
                marks.append(f'<polyline points="{pts}" fill="none" stroke="{col}" stroke-width="2.5"/>')
                marks += [f'<circle cx="{l + step*i + step/2:.1f}" cy="{t + ph - ph*v/top:.1f}" r="3.5" fill="{col}">'
                          f'<title>{esc(labels[i])} · {esc(name)}: {fmt(v)}</title></circle>' for i, v in enumerate(vals)]
        else:
            gw = min(step * 0.72, 56 * len(series))
            bw = gw / len(series)
            for i in range(n):
                for si, (name, vals) in enumerate(series):
                    bh = ph * vals[i] / top
                    x = l + step*i + (step-gw)/2 + si*bw
                    marks.append(f'<rect x="{x:.1f}" y="{t+ph-bh:.1f}" width="{bw-1:.1f}" height="{bh:.1f}" fill="{SERIES[si % len(SERIES)]}">'
                                 f'<title>{esc(labels[i])} · {esc(name)}: {fmt(vals[i])}</title></rect>')
        svg = f'<svg viewBox="0 0 {w} {h}" role="img">{"".join(grid)}{"".join(marks)}{xl}</svg>'
    return f'<figure class="chart">{svg}' + (f'<figcaption>{legend}</figcaption>' if legend else "") + "</figure>"


def render_timeline(body, md):
    items = []
    for line in body.strip().splitlines():
        if not line.strip():
            continue
        c = cells(line) + ["", ""]
        items.append(f'<li><span class="when">{md.renderInline(c[0])}</span><div><b>{md.renderInline(c[1])}</b>'
                     + (f'<p>{md.renderInline(c[2])}</p>' if c[2] else "") + "</div></li>")
    return f'<ol class="timeline">{"".join(items)}</ol>'


def build_md():
    md = MarkdownIt("commonmark", {"html": True, "linkify": False, "typographer": True}).enable(["table", "strikethrough"])
    default_fence = md.renderer.rules.get("fence")

    def fence(tokens, idx, options, env):
        tok = tokens[idx]
        info = tok.info.strip().split()
        name = info[0].lower() if info else ""
        arg = info[1].lower() if len(info) > 1 else ""
        if name == "kpi":
            return render_kpi(tok.content, md)
        if name == "chart":
            return render_chart(arg or "bar", tok.content)
        if name == "timeline":
            return render_timeline(tok.content, md)
        if name == "callout":
            tone = arg if arg in ("info", "ok", "warn", "risk") else "info"
            return f'<aside class="callout {tone}">{md.render(tok.content)}</aside>'
        return default_fence(tokens, idx, options, env)

    md.renderer.rules["fence"] = fence
    return md


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:60] or "s"


def post_process(body):
    # task lists
    body = re.sub(r"<li>\[ \]\s*", '<li class="task"><span class="box"></span>', body)
    body = re.sub(r"<li>\[[xX]\]\s*", '<li class="task done"><span class="box">✓</span>', body)
    # heading anchors + TOC
    toc = []

    def anchor(m):
        level, inner = m.group(1), m.group(2)
        text = re.sub(r"<[^>]+>", "", inner)
        sid = slug(html.unescape(text))
        if level == "2":
            toc.append((sid, text))
        return f'<h{level} id="{sid}">{inner}</h{level}>'
    body = re.sub(r"<h([23])>(.*?)</h\1>", anchor, body)
    body = body.replace("<table>", '<div class="tw"><table class="sortable">').replace("</table>", "</table></div>")
    return body, toc


